---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }: any) => data.lang === 'es')) as any[];
  return posts.map((post: any) => {
    const slug = post.id.replace(/^es\//, '').replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props as { post: any };
const { title, description, pubDate, author = 'Stefano Merino', tags = [], alternateSlug } = post.data;

// Render markdown content
const { Content } = typeof (post as any).render === 'function' ? await (post as any).render() : await render(post);

// Format date
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

// Reading time
const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTimeMin = Math.max(1, Math.ceil(wordCount / 200));

// Alternate language URL
const alternateUrl = alternateSlug ? `/blog/en/${alternateSlug}` : '/blog/en/';
---

<BlogLayout
  title={title}
  description={description}
  lang="es"
  isArticle={true}
  pubDate={pubDate}
  author={author}
  alternateUrl={alternateUrl}
>
  <div class="article-container">
    <header class="article-header">
      <a href="/blog/" class="article-back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a todas las entradas</span>
      </a>

      <h1 class="article-title">{title}</h1>

      <div class="article-meta-bar">
        <div class="article-author">
          <span class="article-author-avatar">SM</span>
          <span>{author}</span>
        </div>
        <span class="post-meta-dot"></span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span class="post-meta-dot"></span>
        <span>{readingTimeMin} min de lectura</span>
      </div>

      {tags.length > 0 && (
        <div class="post-tags" style="margin-top: 14px;">
          {tags.map((tag: string) => (
            <span class="tag-badge">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <article class="prose">
      <Content />
    </article>
  </div>
</BlogLayout>
